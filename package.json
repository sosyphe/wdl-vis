{
  "name": "wdl-viewer",
  "version": "0.2.0",
  "description": "WDL workflow parser and visualizer Vue 3 component library",
  "type": "module",
  "license": "MIT",
  "author": "sosyphe",
  "keywords": [
    "wdl",
    "workflow",
    "bioinformatics",
    "dag",
    "visualization",
    "vue",
    "vue3",
    "component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sosyphe/wdl-vis.git"
  },
  "homepage": "https://github.com/sosyphe/wdl-vis#readme",
  "bugs": {
    "url": "https://github.com/sosyphe/wdl-vis/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/vue-wdl-viewer.cjs",
  "module": "./dist/vue-wdl-viewer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-wdl-viewer.js",
      "require": "./dist/vue-wdl-viewer.cjs"
    },
    "./parser": {
      "types": "./dist/types/parser/index.d.ts",
      "import": "./dist/parser.js",
      "require": "./dist/parser.cjs"
    },
    "./style.css": "./dist/wdl-viewer.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && vite build --mode demo",
    "build:lib": "vite build && vue-tsc -p tsconfig.build.json",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:demo": "vite build --mode demo",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.2",
    "vitest": "^1.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.13"
  }
}
